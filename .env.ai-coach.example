# Supabase (auth token verification — mandatory for protected endpoints)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# SUPABASE_ANON_KEY is accepted as a backward-compatible fallback for the above

# RunPod serverless LLM (queue-based)
RUNPOD_API_KEY=
RUNPOD_LLM_ENDPOINT_ID=
RUNPOD_LLM_API_BASE=https://api.runpod.ai/v2
RUNPOD_LLM_TIMEOUT_SECONDS=600
RUNPOD_LLM_POLL_INTERVAL_SECONDS=1.5

# RunPod Whisper (speech-to-text)
RUNPOD_WHISPER_URL=

# RunPod Chatterbox TTS
RUNPOD_TTS_URL=

# RunPod emotion analysis (optional — skipped if left empty)
RUNPOD_TEXT_EMOTION_URL=
RUNPOD_VOICE_EMOTION_URL=

# Chat context limits
CHAT_HISTORY_LIMIT=12
AI_MEMORY_LIMIT=8

# RAG / knowledge base (disabled by default)
ENABLE_RAG=false
QDRANT_URL=
QDRANT_API_KEY=
GROQ_API_KEY=

